// Схема БД игротеки: Алиас + Мафия.
// Postgres хранит долговременное состояние; Redis (онлайн) — горячее.

generator client {
  // Классический генератор: выводит клиент в node_modules/@prisma/client.
  provider      = "prisma-client-js"
  // `native` — под локальную ОС для разработки (Windows/macOS).
  // `debian-openssl-3.0.x` — под базовый образ контейнеров на VPS.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────── Словарь ───────────

/// Подборка тем — то, что игрок видит на экране выбора. Тема входит ровно
/// в одну подборку, поэтому связь один-ко-многим, а не many-to-many:
/// строгое разбиение делает состояние карточки однозначным.
model Collection {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  emoji       String
  description String
  order       Int        @default(0)
  categories  Category[]

  @@index([slug])
}

model Category {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  slug      String         @unique
  emoji     String?
  isPublic  Boolean        @default(true)
  createdAt DateTime       @default(now())

  /// THEME — обычная тема внутри подборки; LEVEL — уровень сложности.
  /// Уровни стоят рядом с подборками: их можно выбрать, но не раскрыть,
  /// поэтому collectionId у них пустой.
  kind         String  @default("THEME")
  collectionId Int?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  /// Порядок внутри подборки (у уровней — между собой).
  order        Int     @default(0)
  isPopular    Boolean @default(false)
  /// newyear | halloween | summer — в свой месяц тема поднимается наверх.
  season       String?

  words WordCategory[]
  games GameCategory[]
  rooms RoomCategory[]

  @@index([slug])
  @@index([collectionId])
}

model Word {
  id         Int            @id @default(autoincrement())
  text       String         @unique
  difficulty Int            @default(1)
  createdAt  DateTime       @default(now())
  categories WordCategory[]
  roundWords RoundWord[]

  @@index([text])
}

model WordCategory {
  wordId     Int
  categoryId Int
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([wordId, categoryId])
  @@index([categoryId])
}

// ─────────── Идентичность ───────────

model User {
  id          String   @id @default(cuid())
  displayName String
  avatarSeed  String?
  createdAt   DateTime @default(now())

  hostedRooms  Room[]        @relation("RoomHost")
  participants Participant[]
  players      Player[]
}

// ─────────── Комнаты (ОНЛАЙН) ───────────

model Room {
  id       String       @id @default(cuid())
  code     String       @unique
  status   RoomStatus   @default(LOBBY)
  platform GamePlatform @default(ALIAS)
  hostId   String
  host     User         @relation("RoomHost", fields: [hostId], references: [id])

  roundTime   Int     @default(60)
  winScore    Int     @default(50)
  penaltySkip Boolean @default(false)

  isPublic Boolean @default(false)
  title    String?

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  games        Game[]
  mafiaGames   MafiaGame[]
  participants Participant[]
  categories   RoomCategory[]

  @@index([code])
  @@index([status])
}

enum RoomStatus {
  LOBBY
  IN_GAME
  FINISHED
}

// Дискриминатор игры на комнате. Алиас — по умолчанию (бэкомпат).
enum GamePlatform {
  ALIAS
  MAFIA
}

model RoomCategory {
  roomId     String
  categoryId Int
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([roomId, categoryId])
  @@index([roomId])
}

model Participant {
  id        String          @id @default(cuid())
  roomId    String
  userId    String
  role      ParticipantRole @default(PLAYER)
  teamId    Int?
  joinOrder Int
  joinedAt  DateTime        @default(now())
  leftAt    DateTime?

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@index([roomId])
  // История спрашивает «в каких комнатах был этот человек»: составной ключ
  // начинается с roomId и такому запросу не помогает.
  @@index([userId])
}

enum ParticipantRole {
  PLAYER
  SPECTATOR
}

// ─────────── Игры ───────────

model Game {
  id       String     @id @default(cuid())
  mode     GameMode
  status   GameStatus @default(IN_PROGRESS)
  ownerKey String

  /// Одна комната — много партий: «Сыграть ещё» заводит новую строку, старая
  /// остаётся в истории. Уникальным этот ключ быть не может.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  roundTime          Int     @default(60)
  winScore           Int     @default(50)
  penaltySkip        Boolean @default(false)
  currentTeamIndex   Int     @default(0)
  currentRoundNumber Int     @default(1)
  usedWordIds        Int[]   @default([])

  /// TEAMS — команды по два и больше. TRIO — трое играют парами по кругу,
  /// каждая команда из одного человека, очки идут обоим игрокам пары.
  format   GameFormat @default(TEAMS)
  /// Номер хода в круге, 0..5. Осмыслен только при format = TRIO: из одного
  /// currentTeamIndex вторую половину круга не восстановить, там те же пары
  /// играют с обменом ролями. Правила — packages/shared/src/trio.ts.
  trioTurn Int        @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  teams          Team[]
  rounds         Round[]
  gameCategories GameCategory[]
  hiddenBy       HiddenGame[]

  @@index([ownerKey])
  @@index([status])
  @@index([roomId])
}

enum GameMode {
  LOCAL
  ONLINE
}

enum GameFormat {
  TEAMS
  TRIO
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
}

model GameCategory {
  gameId     String
  categoryId Int
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([gameId, categoryId])
  @@index([gameId])
}

model Team {
  id                 Int    @id @default(autoincrement())
  gameId             String
  name               String
  color              String
  score              Int    @default(0)
  order              Int
  currentPlayerIndex Int    @default(0)

  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  players      Player[]
  rounds       Round[]
  participants Participant[]

  @@index([gameId])
}

model Player {
  id     Int     @id @default(autoincrement())
  teamId Int
  userId String?
  name   String
  order  Int

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

model Round {
  id            Int       @id @default(autoincrement())
  gameId        String
  teamId        Int
  /// Втроём — команда угадывавшего: очки за раунд получают оба. Обычным Int,
  /// без внешнего ключа: вторая связь Round → Team заставила бы именовать обе
  /// и заводить обратные поля, а команды и раунды всё равно уходят каскадом
  /// вместе с партией, так что повиснуть значение не может.
  partnerTeamId Int?
  roundNumber   Int
  playerName    String
  scoreEarned   Int       @default(0)
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  game  Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team  Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  words RoundWord[]

  @@index([gameId])
  @@index([teamId])
}

model RoundWord {
  id      Int     @id @default(autoincrement())
  roundId Int
  wordId  Int
  guessed Boolean
  order   Int     @default(0)

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  word  Word  @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([wordId])
}

// ─────────── Мафия (история партий) ───────────
// Live-состояние партии живёт в Redis. В Postgres сохраняем итог
// завершённой партии для экрана истории и статистики.

model MafiaGame {
  id String @id @default(cuid())

  /// Одна комната — много партий: «Сыграть ещё» заводит вторую. Уникальным
  /// этот ключ быть не может — persistFinishedGame падал на нём молча, и
  /// вторая партия просто не доезжала до истории.
  roomId String?
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  hostId String
  status MafiaGameStatus @default(IN_PROGRESS)
  winner MafiaWinnerDb?

  /**
   * Снимок настроек партии (MafiaSettings).
   */
  settings Json
  /**
   * Хроника партии (MafiaEvent[]): ночи, смерти, спасения, изгнания.
   * Нужна, чтобы история игр показывала не только счёт, но и ход партии.
   */
  events   Json?
  dayCount Int  @default(0)

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  players  MafiaPlayerRecord[]
  hiddenBy HiddenGame[]

  @@index([hostId])
  @@index([status])
  @@index([roomId])
}

enum MafiaGameStatus {
  IN_PROGRESS
  FINISHED
}

enum MafiaWinnerDb {
  CITY
  MAFIA
  MANIAC
}

/**
 * Партия, убранная человеком из своей истории.
 *
 * Онлайн-партию видят все участники, поэтому «удалить» не может значить
 * «стереть у всех»: каждый прячет карточку только у себя. Локальные партии
 * сюда не попадают — там удаление настоящее, игра и правда только твоя.
 *
 * Одна таблица на обе игры: смысл строки один и тот же, а внешние ключи дают
 * каскад — партию удалили по-настоящему, и отметки уходят вместе с ней.
 * Заполнено ровно одно из двух полей; в Postgres NULL в уникальном ключе не
 * конфликтует, поэтому обе пары работают.
 */
model HiddenGame {
  id     Int    @id @default(autoincrement())
  userId String

  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  mafiaGameId String?
  mafiaGame   MafiaGame? @relation(fields: [mafiaGameId], references: [id], onDelete: Cascade)

  hiddenAt DateTime @default(now())

  @@unique([userId, gameId])
  @@unique([userId, mafiaGameId])
  @@index([userId])
}

model MafiaPlayerRecord {
  id           Int       @id @default(autoincrement())
  gameId       String
  game         MafiaGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId       String?
  name         String
  role         String
  alive        Boolean   @default(true)
  eliminatedBy String?
  deathDay     Int?
  order        Int       @default(0)

  @@index([gameId])
}
