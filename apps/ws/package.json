{
  "name": "@alias/ws",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:socket.io --external:ioredis --external:@prisma/client --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "smoke:lobby": "tsx scripts/smoke-lobby.ts",
    "smoke:flow": "tsx scripts/smoke-flow.ts",
    "smoke:game": "tsx scripts/smoke-game.ts",
    "smoke:trio": "tsx scripts/smoke-trio.ts",
    "smoke:trio-online": "tsx scripts/smoke-trio-online.ts",
    "smoke:rejoin": "tsx scripts/smoke-rejoin.ts",
    "smoke:host": "tsx scripts/smoke-host.ts",
    "smoke:ingame": "tsx scripts/smoke-ingame.ts",
    "smoke:reconnect": "tsx scripts/smoke-reconnect.ts",
    "smoke:mafia": "tsx scripts/smoke-mafia.ts",
    "smoke:narrator": "tsx scripts/smoke-narrator.ts"
  },
  "dependencies": {
    "@alias/shared": "*",
    "@prisma/client": "^6.19.3",
    "ioredis": "^5.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
