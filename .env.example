# Скопируй в .env и заполни своими значениями.
# .env в .gitignore — реальные секреты в репозиторий не попадают.

# ─── Локальная разработка ───────────────────────────────────────
# Базы поднимаются из docker-compose.yml: npm run db:up

# PostgreSQL
DATABASE_URL=postgresql://alias:alias@localhost:5432/alias?schema=public

# Redis (локально без TLS)
REDIS_URL=redis://localhost:6379

# HMAC-секрет для подписи WebSocket-токенов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ВАЖНО: одно и то же значение для web и ws.
WS_TOKEN_SECRET=replace-with-64+-char-random-hex

# Адрес WS-сервера для клиента. Локально — отдельный порт.
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ─── Продакшн на VPS ────────────────────────────────────────────
# Файл лежит рядом с docker-compose.prod.yml, права 600.
# Всё крутится в одной docker-сети, наружу смотрит только Caddy.
#
#   # Пароль БД — придумать свой, длинный:
#   POSTGRES_USER=alias
#   POSTGRES_PASSWORD=СИЛЬНЫЙ_ПАРОЛЬ
#   POSTGRES_DB=alias
#
#   # Хосты — имена сервисов из docker-compose.prod.yml:
#   DATABASE_URL=postgresql://alias:СИЛЬНЫЙ_ПАРОЛЬ@postgres:5432/alias?schema=public
#   REDIS_URL=redis://redis:6379
#
#   WS_TOKEN_SECRET=<64+ символов, тот же для web и ws>
#
#   # Пусто: web и ws на одном адресе за прокси, клиент подключится
#   # к origin страницы. Заполнять только если ws вынесен на свой домен.
#   NEXT_PUBLIC_WS_URL=
#
#   # Пока домена нет — доступ по IP:
#   SITE_ADDRESS=:80
#   WS_CORS_ORIGIN=http://IP_СЕРВЕРА
#
#   # Когда появится домен (Caddy сам выпустит сертификат):
#   SITE_ADDRESS=example.com
#   WS_CORS_ORIGIN=https://example.com
